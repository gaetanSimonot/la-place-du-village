{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/journal-hebdo",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/newsletter-welcome",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/newsletter-welcome",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/newsletter-hebdo",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/cron/event-reminder",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/transport-gtfs",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron/collector-veille",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/vignettes",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/meteo?source=arome",
      "schedule": "50 1-23/3 * * *"
    },
    {
      "path": "/api/cron/meteo?source=jours",
      "schedule": "40 8,20 * * *"
    }
  ]
}
